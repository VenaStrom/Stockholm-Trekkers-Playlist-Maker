{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stockholm Trekkers Playlist Maker",
  "version": "4.0.0",
  "identifier": "com.stockholm-trekkers.playlist-maker",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "yarn vite:dev",
    "beforeBuildCommand": "yarn vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stockholm Trekkers Playlist Maker",
        "width": 1920,
        "height": 1080,
        "resizable": true,
        "maximizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "icon": [
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}