{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Media file access and write permissions.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:app:allow-set-app-theme",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir",
    "fs:default",
    "fs:allow-appdata-meta-recursive",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-app-meta-recursive",
    "fs:allow-app-read-recursive",
    "fs:allow-app-write-recursive",
    "fs:allow-temp-read",
    "fs:allow-temp-write",
    "fs:allow-exists",
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$RESOURCE/video-assets"
        },
        {
          "path": "$RESOURCE/video-assets/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [
        {
          "path": "/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        "$HOME/Downloads",
        "$HOME/Downloads/**",
        "$HOME/Desktop",
        "$HOME/Desktop/**",
        "$HOME/downloads",
        "$HOME/downloads/**",
        "$HOME/desktop",
        "$HOME/desktop/**"
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        "$HOME/Downloads",
        "$HOME/Downloads/**",
        "$HOME/Desktop",
        "$HOME/Desktop/**",
        "$HOME/downloads",
        "$HOME/downloads/**",
        "$HOME/desktop",
        "$HOME/desktop/**"
      ]
    },
    "dialog:default",
    "dialog:allow-open",
    "log:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/stplay-ffmpeg",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/stplay-ffprobe",
          "sidecar": true,
          "args": true
        },
        {
          "cmd": "ffmpeg",
          "name": "ffmpeg",
          "args": true
        },
        {
          "cmd": "ffprobe",
          "name": "ffprobe",
          "args": true
        }
      ]
    }
  ]
}