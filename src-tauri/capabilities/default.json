{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Media file access and write permissions.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:app:allow-set-app-theme",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    "fs:default",
    "fs:allow-appdata-meta-recursive",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-app-meta-recursive",
    "fs:allow-app-read-recursive",
    "fs:allow-app-write-recursive",
    "fs:allow-temp-read",
    "fs:allow-temp-write",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$RESOURCE/video-assets"
        },
        {
          "path": "$RESOURCE/video-assets/**"
        },
        {
          "path": "$HOME/stockholm-trekkers-playlist-maker/user-data/save-files"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    "dialog:default",
    "dialog:allow-open",
    "log:default",
    "process:default",
    "updater:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/stplay-ffmpeg",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/stplay-ffprobe",
          "sidecar": true,
          "args": true
        },
        {
          "cmd": "ffmpeg",
          "name": "ffmpeg",
          "args": true
        },
        {
          "cmd": "ffprobe",
          "name": "ffprobe",
          "args": true
        }
      ]
    }
  ]
}