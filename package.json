{
  "name": "stockholm-trekkers-playlist-maker",
  "version": "4.1.2",
  "author": "Vena Ström <vena.strom+stplay@pm.me>",
  "description": "A playlist maker for the Stockholm Trekkers organization.",
  "license": "MIT",
  "repository": "https://github.com/VenaStrom/Stockholm-Trekkers-Playlist-Maker.git",
  "contributors": [
    {
      "name": "Vena Ström",
      "email": "vena.strom+stplay@pm.me",
      "url": "https://venastrom.se"
    }
  ],
  "scripts": {
    "tauri": "tauri",
    "dev": "yarn prepare-ffmpeg-sidecar && yarn tauri dev",
    "build": "yarn download-assets && yarn prepare-ffmpeg-sidecar && APPIMAGE_EXTRACT_AND_RUN=1 yarn tauri build && yarn rename-bundles",
    "vite:dev": "vite",
    "vite:build": "yarn lint && vite build",
    "lint": "tsc --noEmit -p ./tsconfig.json && eslint -c ./eslint.config.ts --cache --concurrency auto",
    "download-assets": "tsx scripts/download-video-assets.ts",
    "generate-ffmpeg-arg-types": "tsx scripts/generate-ffmpeg-arg-types.ts",
    "prepare-ffmpeg-sidecar": "tsx scripts/prepare-ffmpeg-sidecar.ts",
    "rename-bundles": "tsx scripts/rename-bundles.ts",
    "check:version": "tsx scripts/check-version-bump.ts",
    "logs:open": "tsx scripts/open-logs.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "~2.4.2",
    "@tauri-apps/plugin-fs": "~2.4.5",
    "@tauri-apps/plugin-log": "~2.8.0",
    "@tauri-apps/plugin-opener": "~2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "js-sha256": "^0.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  },
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697"
}
