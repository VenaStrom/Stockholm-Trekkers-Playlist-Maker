{
  "name": "stockholm-trekkers-playlist-maker",
  "version": "4.0.0",
  "author": "Vena Ström <strom.vena+stplay@gmail.com>",
  "description": "A playlist maker for the Stockholm Trekkers organization.",
  "license": "MIT",
  "repository": "https://github.com/VenaStrom/Stockholm-Trekkers-Playlist-Maker.git",
  "contributors": [
    {
      "name": "Vena Ström",
      "email": "strom.vena+stplay@gmail.com",
      "url": "https://venastrom.se"
    }
  ],
  "scripts": {
    "tauri": "tauri",
    "dev": "yarn prepare-ffmpeg-sidecar && yarn tauri dev",
    "build": "yarn download-assets && yarn prepare-ffmpeg-sidecar && yarn tauri build && yarn rename-bundles",
    "vite:dev": "vite",
    "vite:build": "yarn lint && vite build",
    "lint": "tsc --noEmit -p ./tsconfig.json && eslint -c ./eslint.config.ts --cache --concurrency auto",
    "download-assets": "tsx scripts/download-video-assets.ts",
    "generate-ffmpeg-arg-types": "tsx scripts/generate-ffmpeg-arg-types.ts",
    "prepare-ffmpeg-sidecar": "tsx scripts/prepare-ffmpeg-sidecar.ts",
    "rename-bundles": "tsx scripts/rename-bundles.ts",
    "logs:open": "tsx scripts/open-logs.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-fs": "~2",
    "@tauri-apps/plugin-log": "~2",
    "@tauri-apps/plugin-opener": "~2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "js-sha256": "^0.11.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "use-debounce": "^10.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2.10.1",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "globals": "^16.4.0",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.0"
  },
  "private": true,
  "type": "module"
}