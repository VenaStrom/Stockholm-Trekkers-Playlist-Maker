{
  "name": "stockholm-trekkers-playlist-maker",
  "version": "4.0.0",
  "author": "Vena Ström <strom.vena+stplay@gmail.com>",
  "description": "A playlist maker for the Stockholm Trekkers organization.",
  "license": "MIT",
  "repository": "https://github.com/VenaStrom/Stockholm-Trekkers-Playlist-Maker.git",
  "contributors": [
    {
      "name": "Vena Ström",
      "email": "strom.vena+stplay@gmail.com",
      "url": "https://venastrom.se"
    }
  ],
  "scripts": {
    "tauri": "tauri",
    "dev": "yarn prepare-ffmpeg-sidecar && yarn tauri dev",
    "build": "yarn download-assets && yarn prepare-ffmpeg-sidecar && yarn tauri build && yarn rename-bundles",
    "vite:dev": "vite",
    "vite:build": "yarn lint && vite build",
    "lint": "tsc --noEmit -p ./tsconfig.json && eslint -c ./eslint.config.ts --cache --concurrency auto",
    "download-assets": "tsx scripts/download-video-assets.ts",
    "generate-ffmpeg-arg-types": "tsx scripts/generate-ffmpeg-arg-types.ts",
    "prepare-ffmpeg-sidecar": "tsx scripts/prepare-ffmpeg-sidecar.ts",
    "rename-bundles": "tsx scripts/rename-bundles.ts",
    "logs:open": "tsx scripts/open-logs.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "~2.7.1",
    "@tauri-apps/plugin-fs": "~2.5.1",
    "@tauri-apps/plugin-log": "~2.8.0",
    "@tauri-apps/plugin-opener": "~2.5.4",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "js-sha256": "^0.11.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "globals": "^16.5.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16"
  },
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.16.0+sha512.5374c94eb4ef6aa8188fb112f20c1aa6569f248d676c5e576e1fd2a1a4d8d87a96df65d9dfe1c2a0252cbe38bda46cf18d955005b81b43cc7607a5c9d56fd2b6"
}
